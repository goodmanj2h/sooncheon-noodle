# ==============================================================================
# 공공데이터포털(data.go.kr) 및 클라우드(Supabase) 설정 파일 예시 (.env.example)
# 이 파일을 복사하여 이름을 '.env'로 변경한 후, 발급받으신 인증키를 입력하세요.
# 주의: 실제 '.env' 파일은 보안을 위해 외부에 공개하거나 깃허브 등에 공유하시면 안 됩니다.
# ==============================================================================

# 1. 공공데이터포털 일반 인증키 (Encoding 또는 Decoding 키 중 하나 입력)
DATA_GO_KR_API_KEY=1820bdba17c6bc8f2717b5d79e2aceb50deac984e9993ed41ffa598d89ba9e44

# 2. 순천시 행정구역 코드 (전라남도 순천시 법정 시군구 코드: 46150)
TARGET_CITY_CODE=46150
TARGET_CITY_NAME=순천시

# 3. Supabase 클라우드 데이터베이스 연동 정보 (선택사항 - 24시간 실시간 DB 연동 시)
# https://supabase.com 프로젝트 대시보드 > Project Settings > API 에서 확인 가능
SUPABASE_URL=여기에_슈파베이스_프로젝트_URL을_붙여넣으세요
SUPABASE_ANON_KEY=여기에_슈파베이스_ANON_키를_붙여넣으세요
SUPABASE_SERVICE_ROLE_KEY=여기에_슈파베이스_SERVICE_ROLE_키를_붙여넣으세요
